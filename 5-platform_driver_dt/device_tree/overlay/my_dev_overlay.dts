/dts-v1/;
/plugin/;

/{
    fragment@0{
        target = <&pcd1>;
        # target-path = "/pcd-device-1";
        __overlay__{
            size = <256>;
        };
    };

    fragment@1{
        target = <&pcd2>;
        # target-path = "/pcd-device-2";
        __overlay__{
            size = <2048>;
        };
    };
};
